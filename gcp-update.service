[Unit]
Description=Google Cloud docs incremental update (new + lastmod-stale pages only)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/data

[Service]
Type=oneshot
User=root
WorkingDirectory=/data/opencode/gcpdocs
ExecStart=/usr/bin/python3 /data/opencode/gcpdocs/update_gcp.py --concurrency 20
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
